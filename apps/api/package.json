{
  "name": "@fixtura/api",
  "version": "0.0.1",
  "description": "Fixtura API — NestJS + TypeORM + PostgreSQL RLS",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/database/cleanup-orphans.js && node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "_": "─── Migration scripts. En dist/ (producción container) usar `:prod`. En dev local con código fuente, usar la versión normal con :ts ───",
    "migration:generate": "npx typeorm-ts-node-commonjs migration:generate -d src/database/datasource.ts",
    "migration:run": "node ./node_modules/typeorm/cli.js migration:run -d dist/database/datasource.js",
    "migration:revert": "node ./node_modules/typeorm/cli.js migration:revert -d dist/database/datasource.js",
    "migration:show": "node ./node_modules/typeorm/cli.js migration:show -d dist/database/datasource.js",
    "migration:run:dev": "npx typeorm-ts-node-commonjs migration:run -d src/database/datasource.ts",
    "migration:revert:dev": "npx typeorm-ts-node-commonjs migration:revert -d src/database/datasource.ts",
    "db:seed": "node dist/database/seed.js",
    "db:seed:dev": "ts-node -r tsconfig-paths/register src/database/seed.ts",
    "db:seed:extra": "node dist/database/seed-extra.js",
    "db:seed:extra:dev": "ts-node -r tsconfig-paths/register src/database/seed-extra.ts"
  },
  "dependencies": {
    "@fixtura/domain": "workspace:*",
    "@fixtura/types": "workspace:*",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.24",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.24",
    "@sentry/nestjs": "^10.21.0",
    "@sentry/profiling-node": "^10.21.0",
    "@willsoto/nestjs-prometheus": "^6.0.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.30.0",
    "cache-manager": "^6.4.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "ioredis": "^5.4.1",
    "nestjs-pino": "^4.5.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.19.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^11.3.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.12.4",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "typeorm": "^0.3.20",
    "typeorm-transactional": "^0.5.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@fixtura/config": "workspace:*",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "jest": "^30.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "modules/**/*.service.ts",
      "modules/**/*.controller.ts",
      "common/**/*.ts",
      "!**/*.module.ts",
      "!**/*.entity.ts",
      "!**/*.dto.ts",
      "!**/index.ts",
      "!database/**"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "testTimeout": 30000,
    "maxWorkers": "50%"
  }
}
