{
  "name": "fixtura",
  "version": "0.1.0",
  "private": true,
  "description": "Fixtura — SaaS multi-tenant para gestión de ligas amateur",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:ci": "turbo run test -- --ci --coverage --forceExit --maxWorkers=50%",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" --ignore-path .gitignore",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "db:migrate": "pnpm --filter @fixtura/api run migration:run",
    "db:migrate:revert": "pnpm --filter @fixtura/api run migration:revert",
    "db:seed": "pnpm --filter @fixtura/api run db:seed"
  },
  "devDependencies": {
    "@fixtura/config": "workspace:*",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "comment": "M8 — overrides de transitivas vulnerables con parche en el mismo major (selector acotado al rango vulnerable, no toca otros majors). next NO se puede acá: sus advisories piden 15.x (breaking). xlsx no tiene parche en npm (mitigado en el cliente, A8).",
    "overrides": {
      "@babel/core@<=7.29.0": ">=7.29.6",
      "form-data@>=4.0.0 <4.0.6": ">=4.0.6",
      "glob@>=10.2.0 <10.5.0": ">=10.5.0",
      "js-yaml@<=4.1.1": ">=4.2.0",
      "multer@<2.2.0": ">=2.2.0",
      "postcss@<8.5.10": ">=8.5.10",
      "ws@>=8.0.0 <8.21.0": ">=8.21.0"
    }
  }
}
