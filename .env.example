# ─────────────────────────────────────────────────────────────────────
# Fixtura — Variables de entorno
# ─────────────────────────────────────────────────────────────────────
# Copiar este archivo a .env (en raíz, en apps/api/, o donde corresponda)
# y completar con valores reales. NUNCA commitear .env.
#
# En producción, los secretos vienen del runtime (Docker, Render env).
# Este archivo solo documenta qué variables existen.

# ─── Node ────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# Git SHA — se inyecta en el build de Docker para exponer en /health/version
# En CI/CD: export GIT_SHA=$(git rev-parse --short HEAD)
GIT_SHA=local

# ─── Base de datos PostgreSQL 16 ─────────────────────────────────────
# Usuario superuser (DB_USER) — solo para backups y migraciones
DB_NAME=fixtura
DB_USER=fixtura
DB_PASSWORD=cambia-esto-en-produccion-y-usa-32-chars-minimo

# Usuario NON-superuser (DB_APP_USER) — el que usa la API.
# Sin esto, RLS no muerde porque un superuser ignora las policies.
# Crear con: CREATE ROLE fixtura_app LOGIN PASSWORD '...' NOSUPERUSER;
#            GRANT ALL ON ALL TABLES IN SCHEMA public TO fixtura_app;
DB_APP_USER=fixtura_app
DB_APP_PASSWORD=cambia-esto-tambien-32-chars-minimo

# URL completa (opcional, override de las anteriores)
# DATABASE_URL=postgres://fixtura_app:pass@db:5432/fixtura?sslmode=disable
DB_SSL=false
DB_POOL_MAX=20
DB_POOL_MIN=2

# ─── Redis (cache + BullMQ queues + refresh tokens) ──────────────────
REDIS_URL=redis://redis:6379

# ─── JWT y secretos ──────────────────────────────────────────────────
# En prod: mínimo 32 caracteres, no valores default conocidos.
# Generar con: openssl rand -base64 32
JWT_SECRET=cambia-esto-por-32-caracteres-minimo-aleatorios-prod
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# SSO_STATE_SECRET — distinto de JWT_SECRET, firma cookies state OIDC.
SSO_STATE_SECRET=otro-secreto-distinto-32-chars-para-cookies-state

# ─── CORS ────────────────────────────────────────────────────────────
# OBLIGATORIO en producción. Coma-separado si hay múltiples orígenes.
# Sin esto, el container falla al bootstrap (defensa en profundidad).
FRONTEND_URL=http://localhost:3001

# ─── Observabilidad ──────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Frontend Sentry (sourcemaps en build)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Métricas Prometheus protegidas con basic auth
METRICS_USER=
METRICS_PASSWORD=

# ─── Email (Resend para MVP; Postmark/SES en futuro) ─────────────────
# Para enviar correos reales: poner la API key de Resend y un EMAIL_FROM
# con un dominio VERIFICADO en Resend (si no, Resend rechaza el envío).
# Sin RESEND_API_KEY el sistema funciona igual, pero los correos quedan en
# modo "log-only" (se loggean, no se envían).
RESEND_API_KEY=
EMAIL_FROM=LigaPlus <no-reply@ligaplus.cl>

# ─── Pasarelas de pago ───────────────────────────────────────────────
# Cifrado de las credenciales de pasarela por liga (Flow/Khipu). Cada liga
# guarda sus llaves desde Ajustes → Pagos; se almacenan cifradas con esta
# clave. Generar con: openssl rand -base64 32. Sin ella, la transferencia
# manual funciona igual, pero no se pueden guardar llaves de pasarela.
PAGOS_ENC_KEY=

# Flow (pasarela real, Etapa 2). Entorno GLOBAL de la plataforma:
#   sandbox (default) → https://sandbox.flow.cl  | production → https://www.flow.cl
# Las credenciales que cargue cada liga en Ajustes → Pagos deben ser del
# mismo entorno. Empezar en sandbox para probar; cambiar a production al salir.
FLOW_MODE=sandbox

# WEBPAY_MODE: mock (default) | sandbox | production
# OJO: el provider real (WebpayPlusProvider) todavía es un STUB que lanza
# error — hay que implementar el SDK de Transbank antes de usar sandbox/
# production. Dejar en 'mock' hasta entonces (simula el flujo sin cobrar).
WEBPAY_MODE=mock
# Transbank Webpay Plus (para cuando se implemente el SDK)
TBK_COMMERCE_CODE=
TBK_API_KEY=
TBK_ENVIRONMENT=integration

# MercadoPago (Fase 2)
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# ─── SII facturación electrónica (Fase 1) ─────────────────────────────
# SII_MODE: mock (default) | sandbox | production
# OJO: el provider real (OpenFacturaProvider) todavía es un STUB que lanza
# error — hay que implementar la integración Open Factura antes de usar
# sandbox/production. Dejar en 'mock' hasta entonces.
SII_MODE=mock
SII_PROVIDER=openfactura
SII_API_KEY=
SII_RUT_EMISOR=

# ─── WhatsApp Cloud API (Meta) — RF-04b ──────────────────────────────
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# ─── FCM push notifications ──────────────────────────────────────────
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# VAPID para Web Push (alternativa a FCM)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tech@ligaplus.cl

# Frontend público
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ─── Cloudinary o S3 (uploads de escudos, fotos, evidencia) ──────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── App URLs ────────────────────────────────────────────────────────
# APP_URL: dominio público del SaaS. Define el CORS del API y la base de
#   los links en emails. En prod: https://www.ligaplus.cl
# API_URL: base ABSOLUTA del API, solo para uso server-side (la URL del
#   webhook de Flow). En prod: https://www.ligaplus.cl/api
# NEXT_PUBLIC_API_URL: lo que se hornea en el front. DEBE ser RELATIVA (/api)
#   en multi-tenant, para que el navegador llame a la API del mismo host por
#   el que entró (sin CORS, tenant correcto por Host). NO usar URL absoluta:
#   rompe el acceso por IP y por subdominios de liga.
#   APP_URL=https://www.ligaplus.cl
#   API_URL=https://www.ligaplus.cl/api
#   NEXT_PUBLIC_API_URL=/api
APP_URL=http://localhost:3001
API_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=/api

# ─── Configuración de tenant inicial (seed) ──────────────────────────
SEED_TENANT_SLUG=liga-demo
SEED_TENANT_NAME=Liga Demo
SEED_ADMIN_EMAIL=admin@fixtura.local
SEED_ADMIN_PASSWORD=Fixtura2026!

# Super admin de plataforma (db:seed:superadmin)
SEED_SUPERADMIN_EMAIL=super@ligaplus.cl
SEED_SUPERADMIN_PASSWORD=LigaPlus.Super2026!
